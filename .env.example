# Copy to .env and fill in. The real .env is gitignored and must stay that way:
# RELAY_PRIVATE_KEY in a public repository is an emptied wallet within minutes.
#
#   cp .env.example .env

# Leave true and none of the rest matters — the API answers from the sample
# campaigns in api/mock_data.py. That is how `docker compose up` works for
# anyone cloning the repository, with no keys and no node.
MOCK_MODE=true

# Base Sepolia. The public endpoint is fine for a demo; a provider URL is
# steadier under load.
RPC_URL=https://sepolia.base.org

# From `npm run deploy` in subgraph/. Studio prints it when the deploy finishes.
SUBGRAPH_URL=

# Deployed 7 September, blocks 46522139-46522140. See contracts/README.md on
# feat/contracts-skeleton.
CAMPAIGN_VAULT_ADDRESS=0xf4ADec71da03c6595CF4624f7d4573C9EDb753B0
VISIT_REGISTRY_ADDRESS=0xD33f2e26f11Fe011835D791EbA1BFE123479998A

# Pays the gas so a visitor with an empty wallet can still claim. Use a wallet
# that holds nothing else and keep it funded with Base Sepolia ETH. It signs
# transactions, never visits: the merchant's signature is what the contract
# checks, and this key cannot alter it.
RELAY_PRIVATE_KEY=

# --- World -------------------------------------------------------------------
# From developer.world.org. The app id and rp id are public; the signing key is
# not — World's docs say never expose it to client-side code.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=verify-visitor

# Signs the attestation VisitRegistry verifies. Selfie Check cannot be checked
# on chain — the World ID Router takes Orb only — so the contract trusts this
# signature instead. A separate key from the relay: leaking the relay costs
# gas, leaking this one lets somebody mint verified humans.
ATTESTER_PRIVATE_KEY=
